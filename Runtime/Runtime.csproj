<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>warnings</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Default on. Pass -p:EnableRtpMidiJournal=false to omit RFC 6295 recovery journals. -->
    <EnableRtpMidiJournal Condition="'$(EnableRtpMidiJournal)' == ''">true</EnableRtpMidiJournal>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRtpMidiJournal)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_RTP_MIDI_JOURNAL</DefineConstants>
  </PropertyGroup>

</Project>
